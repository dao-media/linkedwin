# App gate (required in production / on Vercel)
APP_PASSWORD=linkedwin

# Shared remote SQLite (Turso / libSQL) — required on Vercel + Fly so both hosts share posts/jobs/session
# Create a DB at https://turso.tech then:
#   LIBSQL_URL=libsql://your-db-your-org.turso.io
#   LIBSQL_AUTH_TOKEN=...
# Aliases TURSO_DATABASE_URL / TURSO_AUTH_TOKEN also work.
# Local `npm run dev` falls back to ./data/linkedwin.db when unset.
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# Zernio (https://zernio.com) — free for first 2 connected accounts
ZERNIO_API_KEY=
ZERNIO_LINKEDIN_ACCOUNT_ID=
ZERNIO_BASE_URL=https://api.zernio.com
# When unset: hard-fail schedule/update if Zernio credentials are configured.
# Set false only for local-only demos that skip LinkedIn publishing.
# ZERNIO_REQUIRED=false

# Cron / worker auth (Vercel Cron + Fly)
CRON_SECRET=change-me
WORKER_SECRET=change-me

# Browser automation (12h repost + second comments)
# `npm run dev` starts a local worker that polls jobs automatically.
# Leave PLAYWRIGHT_ENABLED=true and WORKER_DRY_RUN=false for real runs.
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_HEADLESS=true
WORKER_DRY_RUN=false
# How often the local worker checks for due jobs (ms)
WORKER_POLL_MS=60000

# Optional: override sqlite path for local file mode (default ./data/linkedwin.db)
# SQLITE_PATH=

# Vercel Blob for Composer media uploads (required on Vercel — local FS does not persist)
# Create a Blob store in the Vercel dashboard, then:
#   vercel env pull
# BLOB_READ_WRITE_TOKEN=
