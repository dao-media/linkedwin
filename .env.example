# App gate
APP_PASSWORD=linkedwin

# Zernio (https://zernio.com) — free for first 2 connected accounts
ZERNIO_API_KEY=
ZERNIO_LINKEDIN_ACCOUNT_ID=
ZERNIO_BASE_URL=https://api.zernio.com
# Set true to fail hard when Zernio is unreachable
ZERNIO_REQUIRED=false

# Cron / worker auth (Vercel Cron + Fly)
CRON_SECRET=change-me
WORKER_SECRET=change-me

# Browser automation (12h repost + second comments)
# `npm run dev` starts a local worker that polls jobs automatically.
# Leave PLAYWRIGHT_ENABLED=true and WORKER_DRY_RUN=false for real runs.
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_HEADLESS=true
WORKER_DRY_RUN=false
# How often the local worker checks for due jobs (ms)
WORKER_POLL_MS=60000

# Optional: override sqlite path (default ./data/linkedwin.db)
# SQLITE_PATH=

# Optional: Vercel Blob for Composer media uploads (required on Vercel for durable public URLs)
# Create a Blob store in the Vercel dashboard, then:
#   vercel env pull
# BLOB_READ_WRITE_TOKEN=
