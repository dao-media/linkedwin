# ── Required ─────────────────────────────────────────────────────────
# Password for your dashboard (required in production)
APP_PASSWORD=change-me

# Shared database (Turso / libSQL). Required on Vercel and for the GitHub sync Action.
#   turso db create linkedwin && turso db show linkedwin --url && turso db tokens create linkedwin
# Aliases TURSO_DATABASE_URL / TURSO_AUTH_TOKEN also work.
# Leave unset for local-only `npm run dev` (uses ./data/linkedwin.db).
# LIBSQL_URL=libsql://linkedwin-<you>.turso.io
# LIBSQL_AUTH_TOKEN=

# Media uploads in Composer (required on Vercel; local dev writes to ./data/uploads)
# Vercel → Storage → Blob → connect to project (sets this automatically)
# BLOB_READ_WRITE_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────
# Protects /api/cron/* (Vercel sets the Authorization header from this)
CRON_SECRET=change-me

# Activity sync: set false to watch the browser during `npm run activity:sync`
PLAYWRIGHT_HEADLESS=true
# Profile to read (default "me" = whoever the captured session belongs to)
# LINKEDIN_PROFILE_SLUG=

# Zernio analytics add-on (read-only; LinkedWin never publishes)
# ZERNIO_API_KEY=
# ZERNIO_LINKEDIN_ACCOUNT_ID=
# ZERNIO_BASE_URL=https://api.zernio.com

# Override the local SQLite path (default ./data/linkedwin.db)
# SQLITE_PATH=
